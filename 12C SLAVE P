#include <Wire.h>

// Konfigurasi Pin Sensor
int pinSuhu = A0;   // Sesuai gambarmu, TMP36 dicolok ke A0
int pinLDR = A1;    // Pindahkan kabel LDR ke pin A1

volatile char perintahMaster = '0'; 

void setup() {
  Wire.begin(8);                  
  Wire.onReceive(terimaPerintah); 
  
  Serial.begin(9600);
  Serial.println("Slave Standby. Menunggu instruksi Master...");
}

void loop() {
  // --- PILIHAN 1: CAHAYA ---
  if (perintahMaster == '1') {
    int nilaiCahaya = analogRead(pinLDR);
    Serial.print("[CAHAYA] Nilai LDR: ");
    Serial.println(nilaiCahaya);
  } 
  // --- PILIHAN 2: SUHU (TMP36) ---
  else if (perintahMaster == '2') {
    int nilaiADC = analogRead(pinSuhu);
    // Rumus konversi TMP36 persis seperti kodemu sebelumnya
    float voltase = nilaiADC * (5.0 / 1023.0);
    float suhu = (voltase - 0.5) * 100;
    
    Serial.print("[SUHU] Derajat: ");
    Serial.print(suhu);
    Serial.println(" C");
  } 
  // --- PILIHAN 3: KELEMBAPAN ---
  else if (perintahMaster == '3') {
    Serial.println("[KELEMBAPAN] Error: Sensor TMP36 tidak bisa membaca kelembapan!");
  }
  
  delay(1000); 
}

// Event otomatis saat Slave menerima data dari Master
void terimaPerintah(int howMany) {
  while (Wire.available()) {
    char dataMasuk = Wire.read();
    if (dataMasuk == '1' || dataMasuk == '2' || dataMasuk == '3') {
      perintahMaster = dataMasuk;
    }
  }
}
